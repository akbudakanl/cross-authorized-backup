# Set default behavior to normalize all text files to LF
* text=auto eol=lf

# Force Linux shell scripts, Dockerfiles, and configs to strictly use LF line endings
*.sh text eol=lf
*.bash text eol=lf
*.config text eol=lf
Dockerfile text eol=lf
*.md text eol=lf

# Ensure binary artifacts and disk images are left untouched
*.png binary
*.jpg binary
*.img binary
*.ext4 binary
*.tar binary
*.gz binary
